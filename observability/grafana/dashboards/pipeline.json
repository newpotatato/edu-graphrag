{
  "uid": "edu-pipeline",
  "title": "Конвейер",
  "tags": [
    "edu-graphrag",
    "hw5"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Очередь: готовые, неподтверждённые и лимит",
      "description": "Лимит относится к ready; unacked считаются отдельно.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "edu-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rabbitmq_queue_messages_ready{queue=\"tasks\"})",
          "legendFormat": "Ready",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(rabbitmq_queue_messages_unacked{queue=\"tasks\"})",
          "legendFormat": "Unacked",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "max(edu_queue_limit{queue=\"tasks\"})",
          "legendFormat": "Лимит ready",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unacked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Лимит ready"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    7,
                    5
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Публикации и завершения",
      "description": "Сравнивайте в устойчивом режиме, когда глубина очереди не растёт.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "edu-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(edu_source_published_total[$__rate_interval]))",
          "legendFormat": "Источник: подтверждено",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(edu_worker_tasks_total{outcome=\"ok\"}[$__rate_interval]))",
          "legendFormat": "Воркеры: завершено",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: задач/с",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Источник: подтверждено"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Воркеры: завершено"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Завершения по воркерам",
      "description": "Только первая успешно сохранённая запись задачи.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "edu-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(edu_worker_tasks_total{outcome=\"ok\",instance=~\"${worker:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: задач/с",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
