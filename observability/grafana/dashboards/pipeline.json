      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(edu_worker_inference_duration_seconds_bucket{instance=~\"${worker:regex}\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "edu-prometheus"
