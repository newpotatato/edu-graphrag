# Copy to `.env` and fill in the passwords: `cp .env.example .env`.
# `.env` is git-ignored; never commit real secrets.

# --- application ---
LOG_LEVEL=INFO
# true: JSON lines (docker/CI); false: colored human-readable output
LOG_JSON=true
HEALTH_CHECK_TIMEOUT=2.0
APP_PORT=8000

# --- PostgreSQL (same names as the official image uses) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=edu
POSTGRES_PASSWORD=
POSTGRES_DB=edu_graphrag

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j requires at least 8 characters.
NEO4J_PASSWORD=

# --- MLflow tracking server ---
# For host-side scripts (training); inside compose the app uses http://mlflow:5000.
# Artifacts are proxied by the server, so clients need no S3 credentials.
MLFLOW_TRACKING_URI=http://localhost:5000
# Do not use presigned direct-to-S3 transfers: the S3 endpoint is internal to compose.
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_PORT=5000
# Registered model the app loads, and the alias that points to the served version.
MODEL_NAME=subject-classifier
MODEL_ALIAS=champion

# MLflow backend store: a separate PostgreSQL instance (not the product database).
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=
MLFLOW_DB_NAME=mlflow

# MLflow artifact store: SeaweedFS S3 API; only the MLflow server uses these keys.
MLFLOW_S3_ACCESS_KEY=mlflow
MLFLOW_S3_SECRET_KEY=
