# Copy to `.env` and fill in the passwords: `cp .env.example .env`.
# `.env` is git-ignored; never commit real secrets.

# --- application ---
LOG_LEVEL=INFO
# true: JSON lines (docker/CI); false: colored human-readable output
LOG_JSON=true
HEALTH_CHECK_TIMEOUT=2.0
APP_PORT=8000

# Host-side addresses use 127.0.0.1, not localhost: on Windows `localhost` resolves to ::1
# first, Docker publishes ports on IPv4 only, and every new connection waits ~2 s.

# --- PostgreSQL (same names as the official image uses) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=edu
POSTGRES_PASSWORD=
POSTGRES_DB=edu_graphrag

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# Neo4j requires at least 8 characters.
NEO4J_PASSWORD=

# --- MLflow tracking server ---
# For host-side scripts (training); inside compose the app uses http://mlflow:5000.
# Artifacts are proxied by the server, so clients need no S3 credentials.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Do not use presigned direct-to-S3 transfers: the S3 endpoint is internal to compose.
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_PORT=5000
# Registered model the app loads, and the alias that points to the served version.
MODEL_NAME=subject-classifier
MODEL_ALIAS=champion

# MLflow backend store: a separate PostgreSQL instance (not the product database).
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=
MLFLOW_DB_NAME=mlflow

# MLflow artifact store: SeaweedFS S3 API; only the MLflow server uses these keys.
MLFLOW_S3_ACCESS_KEY=mlflow
MLFLOW_S3_SECRET_KEY=

# --- RabbitMQ (task pipeline) ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=edu
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# --- Task pipeline ---
# Capacity of the tasks queue (RabbitMQ policy; 0 = unbounded, experiment baseline).
QUEUE_MAX_LENGTH=200
# Deliveries before a failing message goes to tasks.dlq.
DELIVERY_LIMIT=3
# Inference threads per worker; prefetch_count is derived from it.
WORKER_CONCURRENCY=4
# Simulated inference cost per task, ms (reproducible worker throughput).
INFERENCE_DELAY_MS=200
PUBLISH_CONFIRM_TIMEOUT=2.0
# Worker: how long in-flight tasks may take to finish on SIGTERM, seconds
# (must stay below the compose stop_grace_period of 30 s).
WORKER_GRACEFUL_TIMEOUT=20
# true: the worker drains tasks.dlq into Postgres (status=failed); false keeps dead letters
# in the queue for inspection (Management UI: http://127.0.0.1:15672).
DLQ_RECORDER_ENABLED=false
